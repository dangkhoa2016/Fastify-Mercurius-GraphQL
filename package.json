{
	"name": "fastify-mercurius-graphql",
	"version": "2.0.0",
	"main": "app.js",
	"scripts": {
		"start": "NODE_ENV=production node app.js",
		"dev": "NODE_ENV=development nodemon app.js",
		"db_rollback": "knex migrate:rollback --knexfile=config/knexfile",
		"db_seed": "knex seed:run --knexfile=config/knexfile",
		"db_migrate": "knex migrate:latest --knexfile=config/knexfile",
		"install:clean": "rm -rf node_modules package-lock.json && npm install"
	},
	"keywords": [
		"graphql",
		"mercurius",
		"fastify",
		"knex",
		"sqlite",
		"auth"
	],
	"author": "Yuri Fontella, Dang Khoa",
	"license": "ISC",
	"dependencies": {
		"@fastify/autoload": "^6.3.1",
		"@fastify/compress": "^8.3.1",
		"@fastify/cors": "^11.2.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/static": "^9.1.3",
		"@graphql-tools/load-files": "^7.0.1",
		"@graphql-tools/merge": "^9.1.9",
		"@graphql-tools/resolvers-composition": "^7.0.31",
		"@graphql-tools/schema": "^10.0.33",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^12.9.0",
		"dotenv": "^17.4.2",
		"fastify": "^5.8.5",
		"fastify-plugin": "^5.1.0",
		"knex": "^3.2.9",
		"mercurius": "^16.9.0",
		"mercurius-auth": "^6.0.0"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.4.0",
		"eslint": "^10.3.0",
		"nodemon": "^3.1.14"
	}
}
